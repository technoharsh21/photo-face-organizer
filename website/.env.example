# ==============================================================================
# Photo Face Organizer Website - Environment Configuration
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO=technoharsh21/photo-face-organizer

# ==============================================================================
# SMTP Email Configuration (Used for Contact Us form & Automated Receipts)
# ==============================================================================

# Your email address (e.g., yourname@gmail.com)
SMTP_USER=your_email@gmail.com

# Your email App Password / Secret
# For Gmail: Generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_char_app_password

# Destination email to receive visitor inquiries (defaults to SMTP_USER if empty)
CONTACT_EMAIL=your_email@gmail.com

# Optional: SMTP Server Host & Port (Auto-detected if using Gmail, Outlook, or Yahoo)
# Gmail: smtp.gmail.com (Port 587 or 465)
# Outlook / Hotmail: smtp.office365.com (Port 587)
# Yahoo: smtp.mail.yahoo.com (Port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
