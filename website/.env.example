# Production Site Canonical URL (used for sitemap, robots.txt, and OpenGraph meta tags)
NEXT_PUBLIC_SITE_URL=https://photo-face-organizer.vercel.app

# GitHub Repository URL (used for dynamic release asset checks and links)
NEXT_PUBLIC_GITHUB_REPO=technoharsh21/photo-face-organizer

# SMTP Server Settings for Contact Us Form (Server-side only, never exposed to client)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=contact@example.com
SMTP_PASSWORD=your-secret-smtp-password-here
CONTACT_EMAIL=support@technoharsh.com
